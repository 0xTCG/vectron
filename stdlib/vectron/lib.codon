import time
import openmp as omp
from experimental.simd import Vec


# For IR pass hacks. Just leave here and ignore for now.
def _get_vec(LANE_SIZE: Literal[int], T: type, THREADS: Literal[int]):
    return Vec[T, LANE_SIZE](T(0))
def _get_vec_list(LANE_SIZE: Literal[int], T: type, THREADS: Literal[int]):
    return [_get_vec(LANE_SIZE, T, THREADS)]


@extend
class int:
    def __getitem__(self, *args):
        return self


@extend
class Vec:
    def __bool__(self: Vec[T, N]) -> bool:
        raise ValueError("IR pass malfunctioned: cannot call bool on Vec")

    def __int__(self: Vec[T, N]) -> int:
        raise ValueError("IR pass malfunctioned: cannot call int on Vec")


@extend
class List:
    # def __setitem__(self: List[Vec[VT, VN]], idx: int, val: VT, VT: type, VN: Literal[int]):
        # superf(self, idx, Vec[VT, VN](val))
        # BUG: should be self[idx] = Vec[VT, VN](val)

    def __setitem__(self: List[Vec[VT, VN]], idx: int, val: int, VT: type, VN: Literal[int]):
        self[idx] = Vec[VT, VN](VT(val))

    def transpose(self: List[T]) -> List[T]:
        if not self:
            return self
        if isinstance(T, List[List]):
            compile_error("List.transpose: Cannot transpose dimension larger than 2")
        elif isinstance(T, List):
            rows, cols = len(self), len(self[0])
            return [[self[j][i] for j in range(rows)] for i in range(cols)]
        else:
            return self


def to_int_nucl(n, T: type):
    if n == "A": return T(0)
    if n == "C": return T(1)
    if n == "G": return T(2)
    if n == "T": return T(3)
    if n == "N": return T(-1)
    raise ValueError(f"Invalid nucl: {n}")

def canon(seqs, T: type = Int[16]):
    return [[to_int_nucl(c, T=T) for c in seq] for seq in seqs]


@llvm
@pure
@inline
def _vec_and(x: Vec[u1, LANE_SIZE], y: Vec[u1, LANE_SIZE], LANE_SIZE: Literal[int]) -> Vec[u1, LANE_SIZE]:
    %0 = and <{=LANE_SIZE} x i1> %x, %y
    ret <{=LANE_SIZE} x i1> %0


@llvm
@pure
@inline
def _vec_or(x: Vec[u1, LANE_SIZE], y: Vec[u1, LANE_SIZE], LANE_SIZE: Literal[int]) -> Vec[u1, LANE_SIZE]:
    %0 = or <{=LANE_SIZE} x i1> %x, %y
    ret <{=LANE_SIZE} x i1> %0


def vec_and[T](a: T, b: T) -> T:
    if isinstance(a, Vec) and isinstance(b, Vec):
        return _vec_and(a, b)
    if not isinstance(a, Vec) and not isinstance(b, Vec):
        return a and b
    compile_error("vec_and: cannot mix vector and scalar")


def vec_or[T](a: T, b: T) -> T:
    if isinstance(a, Vec) and isinstance(b, Vec):
        return _vec_or(a, b)
    if not isinstance(a, Vec) and not isinstance(b, Vec):
        return a or b
    compile_error("vec_or: cannot mix vector and scalar")


def ternary(cmp, x, y, LANE_SIZE: Literal[int], T: type):
    if isinstance(x, Vec) and isinstance(y, Vec):
        return x.mask(cmp, y)
    if isinstance(x, Vec):
        return x.mask(cmp, Vec[T, LANE_SIZE](T(y)))
    if isinstance(y, Vec):
        return Vec[T, LANE_SIZE](T(x)).mask(cmp, y)
    return Vec[T, LANE_SIZE](T(x)).mask(cmp, Vec[T, LANE_SIZE](T(y)))


def maximum(*args):
    if static.len(args) == 0:
        compile_error("invalid args for max")
    if static.len(args) == 1:
        return args[0]
    if static.len(args) == 2:
        if isinstance(args[0], Vec) and isinstance(args[1], Vec):
            return args[0].llvm_max(args[1])
        elif isinstance(args[0], Vec):
            return args[0].llvm_max(type(args[0])(type(args[0]).T(args[1])))
        elif isinstance(args[1], Vec):
            return args[1].llvm_max(type(args[1])(type(args[1]).T(args[0])))
        else:
            return max(*args[:2])
    return maximum(maximum(*args[:2]), *args[2:])


def alpern(xs, ys, vec_foo, LANE_SIZE: Literal[int], T: type, THREADS: Literal[int]):
    with time.timing("Alpern scores"):
        scores = [[0 for _ in range(len(ys))] for _ in range(len(xs))]

    yst = ys.transpose()
    if THREADS == 1:
        for i in range(len(xs)):
            xvecs = [Vec[T, LANE_SIZE](nucl) for nucl in xs[i]]
            for j in range(len(ys) // LANE_SIZE):
                yvecs = [Vec[T, LANE_SIZE](row[j * LANE_SIZE:]) for row in yst]
                r = vec_foo(xvecs, yvecs).scatter()
                for k in static.range(LANE_SIZE):
                    scores[i][j * LANE_SIZE + k] = int(r[k])
    else:
        @par(num_threads=THREADS)
        for i in range(len(xs)):
            xvecs = [Vec[T, LANE_SIZE](nucl) for nucl in xs[i]]
            for j in range(len(ys) // LANE_SIZE):
                yvecs = [Vec[T, LANE_SIZE](row[j * LANE_SIZE:]) for row in yst]
                r = vec_foo(xvecs, yvecs).scatter()
                for k in static.range(LANE_SIZE):
                    scores[i][j * LANE_SIZE + k] = int(r[k])

    return scores


class Cache:
    dp_mat: dict[int, list[list[Vec[T, LANE_SIZE]]]]
    LANE_SIZE: Literal[int]
    T: type

    def __init__(self):
        self.dp_mat = {}

    def __bool__(self):
        return self.dp_mat == {}

    def __repr__(self): return f'<Cache: {len(self.dp_mat)}>'

    def dpmat(self, fn):
        thr_id = omp.get_thread_num()
        if thr_id not in self.dp_mat:
            init = fn()
            self.dp_mat[thr_id] = [
                [Vec[T, LANE_SIZE](T(init[i][j])) for j in range(len(init[0]))]
                for i in range(len(init))
            ]

        return self.dp_mat[thr_id]

cache: Optional[Dict[int, cobj]] = None
def dpmat_wrap(
    fn,
    idx: int,
    LANE_SIZE: Literal[int],
    T: type,
    THREADS: Literal[int]
) -> List[List[Vec[T, LANE_SIZE]]]:
    global cache
    if cache is None:
        cache = {}
    if idx not in cache:
        c = Cache[LANE_SIZE, T]()
        cache[idx] = c.__raw__()
    # Never inherit Cache or this will fail spectacularly
    return __internal__.to_class_ptr(cache[idx], Cache[LANE_SIZE, T]).dpmat(fn)
