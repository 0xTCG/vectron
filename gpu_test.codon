import time
import sys


def to_int_nucl(n, T: type):
    if n == "A": return T(0)
    if n == "C": return T(1)
    if n == "G": return T(2)
    if n == "T": return T(3)
    if n == "N": return T(-1)
    raise ValueError(f"Invalid nucl: {n}")


def canon(seqs, T: type = Int[16]):
    return [[to_int_nucl(c, T=T) for c in seq] for seq in seqs]


with open(sys.argv[-1], 'r') as file:
    seqs_x = [line.strip() for line in file]

with open(sys.argv[-2], 'r') as file:
    seqs_y = [line.strip() for line in file]

        
import numpy as np
import gpu


dtype  = Int[16]  # np.int16
x, y   = canon(seqs_x), canon(seqs_y)
m, n   = len(x), len(y)
N      = 512  # Setting N dynamically does not work
assert max(max(len(seq) for seq in x), max(len(seq) for seq in y)) == N, "All sequences must have length equal to N"
print(f"Sequences X: {m}, Sequences Y: {n}, Max Length: {N}")

BUFFER_SIZE = 128 * 128  # 16384 if m * n > 16384 else m * n
buffer = np.empty((BUFFER_SIZE, N + 1, N + 1), dtype=dtype) 
scores = np.empty((m, n), dtype=dtype)


def lcs_kernel(buffer, q, t, idx):
    for i in range(1, len(q) + 1):
        for j in range(1, len(t) + 1):       
            buffer[idx, i, j] = max(
                buffer[idx, i - 1, j - 1] + dtype(1 if q[i - 1] == t[j - 1] else 0), 
                buffer[idx, i - 1, j], buffer[idx, i, j - 1])
    
    return buffer[idx, len(q), len(t)]


@gpu.kernel
def vectron_kernel(scores, buffer, x, y):
    idx = (gpu.block.x * gpu.block.dim.x) + gpu.thread.x
    m, n = len(x), len(y)

    abs_idx = idx
    while abs_idx < m * n:
        t_idx, q_idx = divmod(abs_idx, n)
        t = x[t_idx]
        q = y[q_idx]
        
        # hamming_kernel(scores, q, t, idx)
        scores[t_idx, q_idx] = lcs_kernel(buffer, q, t, idx)
        abs_idx += BUFFER_SIZE


total_thr_count = BUFFER_SIZE
block = total_thr_count if total_thr_count < 1024 else 1024
grid  = (total_thr_count + block - 1) // block


with time.timing("GPU Vectron"):
    vectron_kernel(scores, buffer, x, y, grid=grid, block=block)
print(sum(scores.flatten().astype(int)))
