import time
import sys
from vectron import vectron, canon


@vectron(lane_size=32, threads=4)
def min_cost_path(h, m):
    q = [[((1 + i * 2) if j == 0 and i > 0 else (1 + j * 3) if i == 0 and j > 0 else 0)
          for j in range(len(h) + 1)] for i in range(len(m) + 1)]

    for i in range(1, len(m) + 1):
        for j in range(1, len(h) + 1):
            q[i][j] = max(
                q[i - 1][j - 1] + (-1 if (m[i - 1] == -1 or h[j - 1] == -1) else 2 if m[i - 1] == h[j - 1] else -3),
                q[i - 1][j] + (-1 if (m[i - 1] == -1 or h[j - 1] == -1) else 1 if m[i - 1] == h[j - 1] else -2),
                q[i][j - 1] + (-2 if (m[i - 1] == -1 or h[j - 1] == -1) else 1 if m[i - 1] == h[j - 1] else -2)
                )

    return q[-1][-1]


with open(sys.argv[-1], 'r') as file:
    seqs_x = [line.strip() for line in file]

with open(sys.argv[-2], 'r') as file:
    seqs_y = [line.strip() for line in file]


with time.timing("Min cost path"):
    x, y = canon(seqs_x), canon(seqs_y)
    scores = [[min_cost_path(x[i], y[j]) for j in range(len(y))] for i in range(len(x))]

print(f"Checksum: {sum([sum([int(e) for e in row]) for row in scores])}")
