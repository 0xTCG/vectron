import time
import sys
from vectron.attributes import vectron
from lib import maximum, canon


@vectron
def levenshtein(Q, T):
    M = [[((-2 - i * 4) if j == 0 else (-2 - j * 4) if i == 0 else 0)
          for j in range(len(Q) + 1)] for i in range(len(T) + 1)]

    for i in range(1, len(T) + 1):
        for j in range(1, len(Q) + 1):
            M[i][j] = maximum(
                M[i - 1][j] - 2,
                M[i][j - 1] - 2,
                M[i - 1][j - 1] + (2 if T[i - 1] == Q[j - 1] else -3)
            )

    return M[-1][-1]


with open(sys.argv[-1], 'r') as file:
    seqs_x = [line.strip() for line in file]

with open(sys.argv[-2], 'r') as file:
    seqs_y = [line.strip() for line in file]


with time.timing("Levenshtein"):
    x, y = canon(seqs_x), canon(seqs_y)
    scores = [[levenshtein(x[i], y[j]) for j in range(len(y))] for i in range(len(x))]

print(f"Checksum: {sum([sum([int(e) for e in row]) for row in scores])}")
