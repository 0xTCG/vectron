import time
import sys
from vectron import vectron, maximum, canon

@vectron
def hamming(t, q):
    M = [[0 for _ in range(len(t) + 1)] for _ in range(len(q) + 1)]
    for i in range(1, len(q) + 1):
        for j in range(1, len(t) + 1):
            if j - i <= -1 or j - i >= 1:
                if j - i == -1 or j - i == 1:
                    M[i][j] = -10000
            else:
                M[i][j] = maximum(
                    M[i - 1][j - 1] + (0 if q[i - 1] == t[j - 1] else 1), 0
                )

    return M[-1][-1]


with open(sys.argv[-1], 'r') as file:
    seqs_x = [line.strip() for line in file]

with open(sys.argv[-2], 'r') as file:
    seqs_y = [line.strip() for line in file]


with time.timing("Hamming"):
    x, y = canon(seqs_x), canon(seqs_y)
    scores = [[hamming(x[i], y[j]) for j in range(len(y))] for i in range(len(x))]


print(f"Checksum: {sum([sum([int(e) for e in row]) for row in scores])}")
