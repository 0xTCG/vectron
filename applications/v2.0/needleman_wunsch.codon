import time
import sys
from vectron.attributes import vectron
from lib import maximum, canon, vec_or


@vectron
def nw(h, m):
    q = [[((-i * 4) if j == 0 and i > 0 else (-j * 4) if i == 0 and j > 0 else 0)
          for j in range(len(h) + 1)] for i in range(len(m) + 1)]  

    for i in range(1, len(m) + 1):
        for j in range(1, len(h) + 1):
            q[i][j] = maximum(q[i - 1][j - 1] + (-3 if vec_or(m[i - 1] == -1, h[j - 1] == -1) else 2 if m[i - 1] == h[j - 1] else -4),
                        q[i - 1][j] - 4, 
                        q[i][j - 1] - 4)

    return q[-1][-1]


with open(sys.argv[-1], 'r') as file:
    seqs_x = [line.strip() for line in file]

with open(sys.argv[-2], 'r') as file:
    seqs_y = [line.strip() for line in file]


with time.timing("NW"):
    x, y = canon(seqs_x), canon(seqs_y)
    scores = [[nw(x[i], y[j]) for j in range(len(y))] for i in range(len(x))]

print(f"Checksum: {sum([sum([int(e) for e in row]) for row in scores])}")
