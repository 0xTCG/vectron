import time
import sys
from vectron import vectron, canon


@vectron(lane_size=32, threads=4)
def gotoh(t, q):
    M = [[((-4 - i * 2) if j == 0 and i > 0 else (-4 - j * 2) if i == 0 and j > 0 else 0)
          for j in range(len(q) + 1)] for i in range(len(t) + 1)]
    E = [[((-4 - i * 2) if j == 0 and i > 0 else -10000)
          for j in range(len(q) + 1)] for i in range(len(t) + 1)]
    F = [[((-4 - j * 2) if i == 0 and j > 0 else -10000)
          for j in range(len(q) + 1)] for i in range(len(t) + 1)]

    for i in range(1, len(t) + 1):
        for j in range(1, len(q) + 1):
            if j - i <= -105 or j - i >= 105:
                if j - i == -105:
                    M[i][j] = -10000
                    F[i][j] = -10000
                    E[i][j] = -10000
            else:
                E[i][j] = max(E[i - 1][j] - 2, M[i - 1][j] - 6)
                F[i][j] = max(F[i][j - 1] - 2, M[i][j - 1] - 6)
                M[i][j] = max(
                    M[i - 1][j - 1] + (-3 if t[i - 1] == -1 or q[j - 1] == -1 else 2 if t[i - 1] == q[j - 1] else -4),
                    E[i][j],
                    F[i][j]
                )

    return M[-1][-1]


with open(sys.argv[-1], 'r') as file:
    seqs_x = [line.strip() for line in file]

with open(sys.argv[-2], 'r') as file:
    seqs_y = [line.strip() for line in file]


with time.timing("SW"):
    x, y = canon(seqs_x), canon(seqs_y)
    scores = [[gotoh(x[i], y[j]) for j in range(len(y))] for i in range(len(x))]

print(f"Checksum: {sum([sum([int(e) for e in row]) for row in scores])}")
